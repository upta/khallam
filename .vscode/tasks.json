{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "site: dev server",
      "type": "npm",
      "script": "site:dev",
      "isBackground": true,
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated"
      },
      // Vite never exits, so the debugger is told to stop waiting the moment the
      // server prints its address rather than when the command finishes.
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*VITE.*ready.*",
          "endsPattern": ".*Local:.*"
        }
      }
    }
  ]
}
